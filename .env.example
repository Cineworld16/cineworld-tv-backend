NODE_ENV=development
PORT=3000
LOG_LEVEL=info

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_ANON_KEY=eyJhbGciOi...

KIRVANO_WEBHOOK_TOKEN=troque-por-um-segredo-longo-aleatorio

ADMIN_EMAILS=admin@exemplo.com,outro-admin@exemplo.com

# 32 bytes base64 — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Brevo — cria conta em brevo.com, verifica um email como "authenticated sender",
# gera API key em SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...
SMTP_FROM_NAME=CineWorld
# Email que voce verificou como sender na Brevo (aparece como remetente)
SMTP_FROM_EMAIL=seu-email-verificado@gmail.com
# opcional: quem recebe as respostas quando o comprador clicar em "Responder"
REPLY_TO_EMAIL=seu-email-verificado@gmail.com

# URL de acesso que aparece no email (pode ser DNS do painel Havok)
ACCESS_URL=http://seu-dns-de-acesso
# WhatsApp de suporte que aparece no email como botão de contato
SUPPORT_WHATSAPP_URL=https://wa.me/55SEUNUMERO

# URL publica do proprio backend (usada pra referenciar imagens no email)
BACKEND_PUBLIC_URL=https://seu-backend.up.railway.app

# ============================================================
# HAVOK (painel IPTV Sigma) — criacao automatica de conta
# ============================================================
# true = cria conta automaticamente pos-compra. false = fluxo manual (padrao).
HAVOK_ENABLED=false
HAVOK_BASE_URL=http://seu-painel-havok
HAVOK_USER=seu-usuario-havok
HAVOK_PASS=sua-senha-havok
HAVOK_SERVER_ID=seu-server-id
# Mapa DURACAO -> package_id (chave real lida pelo codigo e HAVOK_PACKAGES, nao HAVOK_PLANS).
# Duracao e detectada automaticamente pelo texto da oferta/plano da Kirvano
# (mensal/trimestral/semestral/anual). "completo" = com TRIPLO X (adulto),
# "sem_adultos" = padrao (ver lib/havok-plans.ts). Vazio usa os defaults (invalidos p/ seu painel).
HAVOK_PACKAGES={"mensal":{"completo":"package_id_mensal_adulto","sem_adultos":"package_id_mensal_padrao"},"trimestral":{"completo":"...","sem_adultos":"..."},"semestral":{"completo":"...","sem_adultos":"..."},"anual":{"completo":"...","sem_adultos":"..."}}

CORS_ALLOWED_ORIGINS=http://localhost:8081,https://admin.cinerush.tv
